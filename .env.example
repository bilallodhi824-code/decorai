# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Config (Web Client SDK)
# STRICTLY REQUIRED: Fill in your live Firebase project credentials below
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Backend JSON Service Account)
# STRICTLY REQUIRED: Paste your Firebase Admin JSON Service Account key here
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "your_project_id", ...}'

# OpenAI API (For design chat assistant and room suggestions)
OPENAI_API_KEY=your_openai_api_key

# Image Generation API (E.g. Stability AI or OpenAI DALL-E)
# Leave blank to use mock image generation fallback
IMAGE_GENERATION_API_KEY=your_image_generation_api_key
